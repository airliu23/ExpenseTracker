<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限 (AI API调用) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 语音识别权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 通知常驻 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        关闭电池优化。
        空闲期系统（尤其华为/荣耀 ROM）会清理后台服务，通知随之消失；
        而 Android 12+ 又禁止应用在后台启动前台服务，服务被杀后不会自己回来。
        「已关闭电池优化」是 Android 12+ 允许后台拉起前台服务的官方豁免条件之一，
        所以这个权限是看门狗能生效的前提。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ExpenseTrackerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ExpenseTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FunASR Paraformer-Nano 离线语音识别前台服务 -->
        <service
            android:name=".service.FunAsrVoiceService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- 月度账单概览通知服务 -->
        <service
            android:name=".service.MonthSummaryService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <!-- Android 14+ 要求 specialUse 类型必须声明用途，缺失会被 Play 审核拒绝 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_monthly_expense_summary" />
        </service>

        <!-- 常驻通知看门狗：服务被系统清理后负责把它拉回来 -->
        <receiver
            android:name=".service.WatchdogReceiver"
            android:exported="false" />

        <!-- 开机自启 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
